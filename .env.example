# Use runtime secret settings; never commit a filled copy. No credentials needed in synthetic.
# ASSISTANT_CONFIG=config/default.toml
# ASSISTANT_CONFIG_TOML=  (multiline non-secret TOML; do not set with ASSISTANT_CONFIG)
# SYNTHETIC_DATABASE_URL=sqlite:////data/synthetic.db
# LIVE_DATABASE_URL=sqlite:////data/secretary.db
# ALLOW_LIVE_READS=true
# ALLOW_AI_PROCESSING=true
# ALLOW_TELEGRAM_ALL=true # additional consent; only with telegram.mode=all and confirm_all=true
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PEER_HASHES=  (JSON map of explicitly allowed signed peer IDs to access hashes)
# TELEGRAM_SESSION=  (StringSession created outside Codex on trusted local machine)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID= (positive private user chat ID)

# Maintenance only; not needed by the running worker:
# MIGRATION_DATABASE_URL=
# MIGRATION_SOURCE_URL=
# MIGRATION_TARGET_URL=
# TEST_POSTGRES_URL=  (disposable tests only; prefer tools/test_postgres.py)
